{
  "expo": {
    "name": "GSO Mobile Scanner",
    "slug": "gso-mobile-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses your camera to scan QR codes for inventory tracking.",
        "UIRequireAppTransport": false
      }
    },
    "android": {
      "package": "com.gso.mobilescanner",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1e3a8a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {},
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GSO Mobile Scanner to access your camera to scan QR codes."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "barStyle": "light"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "expo-status-bar"
    ],
    "extra": {
      "expo-navigation-bar": {
        "style": "light",
        "hidden": true
      },
      "eas": {
        "projectId": "3b238612-6d59-4325-b190-c4259dac10d1"
      }
    },
    "owner": "aaronmicarte"
  }
}
