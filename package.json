    "axios": "1.6.5",
    "expo": "^57.0.0",
    "expo-camera": "~57.0.5",
    "expo-font": "~57.0.4",
    "expo-navigation-bar": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
