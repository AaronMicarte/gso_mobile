# GSO Mobile Environment Configuration

# API Settings
# Use an address the phone or emulator can actually reach, such as a LAN IP or production URL.
EXPO_PUBLIC_API_URL=http://10.115.52.25:8000/api
EXPO_PUBLIC_API_TIMEOUT=30000

# Sync Settings
EXPO_PUBLIC_SYNC_INTERVAL_MS=30000
EXPO_PUBLIC_MAX_RETRY_ATTEMPTS=5

# Feature Flags
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true
EXPO_PUBLIC_ENABLE_AUTO_SYNC=true

# App Settings
EXPO_PUBLIC_APP_NAME=GSO Mobile
EXPO_PUBLIC_APP_VERSION=1.0.0
